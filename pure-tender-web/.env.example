# Real backend mode: all requests go to the team's Java API at /api/v1
VITE_DEMO_MODE=false
VITE_BACKEND_CONTRACT=team
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_TARGET=http://localhost:8080
# Spring Boot's default per-file multipart limit. Increase only after the server
# sets spring.servlet.multipart.max-file-size and max-request-size accordingly.
VITE_PROPOSAL_MAX_MB=1
# Use npm run dev:demo for the explicit browser-local preview; normal dev/build stay in API mode.
